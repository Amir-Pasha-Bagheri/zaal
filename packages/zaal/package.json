  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Pasha-Bagheri/zaal.git",
    "directory": "packages/zaal"
  },
  "homepage": "https://github.com/Amir-Pasha-Bagheri/zaal/tree/main/packages/zaal",
  "bugs": "https://github.com/Amir-Pasha-Bagheri/zaal/issues"
}
