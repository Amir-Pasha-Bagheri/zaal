{
  "name": "zaal",
  "version": "0.1.0",
  "description": "The `zaal` command: compile .zaal sources into a React app, preview it, rebuild on change.",
  "keywords": [
    "zaal",
    "cli"
  ],
  "type": "module",
  "bin": {
    "zaal": "./bin/zaal"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "dependencies": {
    "@zaal/core": "^0.1.0",
    "@zaal/react": "^0.1.0",
    "@zaal/web": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR-USERNAME/zaal.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/YOUR-USERNAME/zaal/tree/main/packages/cli",
  "bugs": "https://github.com/YOUR-USERNAME/zaal/issues"
}
