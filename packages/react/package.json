{
  "name": "@zal/react",
  "version": "0.1.0",
  "description": "The React target for Zal: compiles .zal sources to a standalone React app.",
  "keywords": ["zal", "react", "dsl", "compiler", "codegen"],
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./*": "./src/*"
  },
  "files": ["src", "README.md"],
  "dependencies": {
    "@zal/core": "^0.1.0"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}
