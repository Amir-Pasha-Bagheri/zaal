{
  "name": "@zaal/react",
  "version": "0.1.0",
  "description": "The React target for Zaal: compiles .zaal sources to a standalone React app, with the ui.zaal design system and app.zaal project model every web target needs.",
  "license": "Apache-2.0",
  "keywords": [
    "zaal",
    "react",
    "dsl",
    "compiler",
    "codegen"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "zaal": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Pasha-Bagheri/zaal.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Amir-Pasha-Bagheri/zaal/tree/main/packages/react",
  "bugs": "https://github.com/Amir-Pasha-Bagheri/zaal/issues"
}
