{
  "name": "zal",
  "version": "0.0.0",
  "private": true,
  "description": "Zal — a token-dense DSL that compiles to a runnable app. This repo holds every package.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "demo": "cd example && node ../packages/cli/bin/zal dev",
    "demo:build": "cd example && node ../packages/cli/bin/zal build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zal/framework.git"
  },
  "homepage": "https://github.com/zal/framework"
}
