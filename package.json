{
  "name": "zaal",
  "version": "0.0.0",
  "private": true,
  "description": "Zaal — a token-dense DSL that compiles to a runnable app. This repo holds every package.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "demo": "cd example && node ../packages/zaal/bin/zaal dev",
    "demo:build": "cd example && node ../packages/zaal/bin/zaal build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Pasha-Bagheri/zaal.git"
  },
  "homepage": "https://github.com/Amir-Pasha-Bagheri/zaal"
}
