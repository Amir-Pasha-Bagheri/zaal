A Demo
  t "Zaal Demo"
  m #root
  ui ./ui.zaal
  css ./styles/extra.css
  pkg canvas-confetti@1.9.3
  pkg framer-motion@11.11.9
  store Theme Todos Caught   // provider order, outermost first
  / Home
  /about About
  /dex Dex
  /dex/:name Pokemon
  /stats Stats lazy          // fetched on first visit, not in the main bundle
  /* NotFound                // the catch-all
