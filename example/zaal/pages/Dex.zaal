i Nav ../components/Nav
i Field ../components/Field
i Spinner ../components/Spinner
i Badge ../components/Badge
i { art } from ../data/dex
i useDex ../hooks/useDex
C Dex
  use { has, toggle } = Caught
  use { q, setQ, status, shown } = useDex()
  %page
    Nav
    h1 "Pokédex"
    %row.search
      Field label="search" val=q @input=setQ(e.target.value) placeholder="pika…"
    ?status == "loading"
      Spinner label="asking the API…"
    :?!shown.length
      %hint "nothing matches “{q}”"
    :
      %grid
        *shown as p k=p.name
          %tile
            Link to="/dex/{p.name}"
              img.sprite src=art(p.name) alt=p.name loading="lazy"
              span "{p.name}"
            %btn.icon @click=toggle(p.name) title="catch" "{has(p.name) ? "★" : "☆"}"
    ?status == "offline"
      Badge text="offline — showing bundled data"
