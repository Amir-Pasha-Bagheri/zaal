// plain SVG, no chart package — and loaded lazily, so it is not in the main bundle
C Sparkline p:points=[] p:w=240 p:h=48
  memo max = Math.max(1, ...points)
  memo d = points.map((v, i) => `${(i / Math.max(1, points.length - 1)) * w},${h - (v / max) * h}`).join(" ")
  svg.spark viewBox="0 0 {w} {h}" width=w height=h role="img"
    polyline points=d fill="none" stroke="currentColor" strokeWidth=2
