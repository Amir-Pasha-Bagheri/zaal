{
  "name": "zaal",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "zaal",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@zaal/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@zaal/react": {
      "resolved": "packages/react",
      "link": true
    },
    "node_modules/@zaal/web": {
      "resolved": "packages/web",
      "link": true
    },
    "node_modules/zaal": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "zaal",
      "version": "0.1.0",
      "dependencies": {
        "@zaal/core": "^0.1.0",
        "@zaal/react": "^0.1.0",
        "@zaal/web": "^0.1.0"
      },
      "bin": {
        "zaal": "bin/zaal"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@zaal/core",
      "version": "0.1.0",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/react": {
      "name": "@zaal/react",
      "version": "0.1.0",
      "dependencies": {
        "@zaal/core": "^0.1.0",
        "@zaal/web": "^0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/web": {
      "name": "@zaal/web",
      "version": "0.1.0",
      "dependencies": {
        "@zaal/core": "^0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
