{
  "name": "zal",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "zal",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@zal/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@zal/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@zal/react": {
      "resolved": "packages/react",
      "link": true
    },
    "packages/cli": {
      "name": "@zal/cli",
      "version": "0.1.0",
      "dependencies": {
        "@zal/core": "^0.1.0",
        "@zal/react": "^0.1.0"
      },
      "bin": {
        "zal": "bin/zal"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@zal/core",
      "version": "0.1.0",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/react": {
      "name": "@zal/react",
      "version": "0.1.0",
      "dependencies": {
        "@zal/core": "^0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
